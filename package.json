{
  "name": "dsh-cross-session-gated",
  "version": "0.1.0",
  "description": "Cross-session task delegation for DeepSeek Harness with tool-level gates and a global session allowlist.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "cross-session",
    "gated",
    "allowlist"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "author": "forked from zsjs110110-cpu/dsh-cross-session-approval",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cong0707/dsh-cross-session-gated.git"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-scope": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-permission-presets": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-user-approval": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.3.0"
  },
  "homepage": "https://github.com/Cong0707/dsh-cross-session-gated#readme",
  "bugs": {
    "url": "https://github.com/Cong0707/dsh-cross-session-gated/issues"
  }
}
